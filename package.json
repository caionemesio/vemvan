{
  "name": "vemvan",
  "private": true,
  "version": "0.0.0",
  "description": "VemVan - corporate transportation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:admin": "npm run dev --workspace apps/admin",
    "db:up": "docker compose --env-file apps/api/.env up -d",
    "db:down": "docker compose --env-file apps/api/.env down",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:migrate:undo": "npm run db:migrate:undo --workspace apps/api"
  }
}
