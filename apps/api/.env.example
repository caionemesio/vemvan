# VemVan API - environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# This file is also the single source of the local PostgreSQL credentials:
# `npm run db:up` reads it through `docker compose --env-file apps/api/.env`.

NODE_ENV=development
PORT=3000

# Database connection. Point these at any PostgreSQL instance (local Docker,
# managed provider, ...) - no code change is required to switch.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vemvan
DB_USER=vemvan
DB_PASSWORD=change-me
DB_SSL=false
